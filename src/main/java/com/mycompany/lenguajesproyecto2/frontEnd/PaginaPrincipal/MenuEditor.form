                          <AuxValues>
                            <AuxValue name="JavaCodeGenerator_AddingCodePost" type="java.lang.String" value="jtreeCarpetas.addMouseListener(new java.awt.event.MouseAdapter() {&#xa;    @Override&#xa;    public void mouseClicked(java.awt.event.MouseEvent evt) {&#xa;&#xa;        if (evt.getClickCount() == 1) { &#xa;            DefaultMutableTreeNode nodoSeleccionado = &#xa;                (DefaultMutableTreeNode) jtreeCarpetas.getLastSelectedPathComponent();&#xa;&#xa;            if (nodoSeleccionado != null &amp;&amp; nodoSeleccionado.isLeaf()) {&#xa;                Object userObject = nodoSeleccionado.getUserObject();&#xa;                &#xa;                if (userObject instanceof ItemArchivo) {&#xa;                    ItemArchivo item = (ItemArchivo) userObject;&#xa;                    File archivoSeleccionado = item.getArchivo();&#xa;                    &#xa;                    escritorDePz(archivoSeleccionado.getAbsolutePath());&#xa;                }&#xa;            }&#xa;        }&#xa;    }&#xa;});"/>
                          </AuxValues>
                        </Component>
                      </SubComponents>
